{
  "name": "dingelschwinng-moe-agent",
  "version": "1.0.0",
  "description": "MoE Agent Chat with System-Critical Permission Guards - Android APK",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "type-check": "tsc --noEmit",
    "android:build": "npm run build && npx cap copy android && npx cap open android",
    "android:sync": "npx cap sync android",
    "android:apk": "cd android && ./gradlew assembleDebug",
    "android:apk:release": "cd android && ./gradlew assembleRelease",
    "android:install": "cd android && ./gradlew installDebug",
    "capacitor:add": "npx cap add android",
    "capacitor:sync": "npx cap sync"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@capacitor/core": "^5.0.0",
    "@capacitor/android": "^5.0.0",
    "@capacitor/app": "^5.0.0",
    "@capacitor/device": "^5.0.0",
    "@capacitor/network": "^5.0.0",
    "@capacitor/usb": "^5.0.0",
    "lucide-react": "^0.263.1",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "vite": "^4.4.0",
    "tailwindcss": "^3.3.0",
    "postcss": "^8.4.0",
    "autoprefixer": "^10.4.0",
    "typescript": "^5.0.0"
  }
}
