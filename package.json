{
  "name": "dingelschwinng-moe-agent",
  "version": "1.0.0",
  "description": "MoE Agent Chat with System-Critical Permission Guards - Android APK",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "wasm:build": "node scripts/test-wasm.cjs",
    "lint": "tsc --noEmit",
    "type-check": "tsc --noEmit",
    "android:build": "npm run build && npx cap copy android && npx cap open android",
    "android:sync": "npx cap sync android",
    "android:apk": "cd android && ./gradlew assembleDebug",
    "android:apk:release": "cd android && ./gradlew assembleRelease",
    "android:install": "cd android && ./gradlew installDebug",
    "capacitor:add": "npx cap add android",
    "capacitor:sync": "npx cap sync"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^3.1.4",
    "@capacitor/android": "^5.0.0",
    "@capacitor/app": "^5.0.0",
    "@capacitor/core": "^5.0.0",
    "@capacitor/device": "^5.0.0",
    "@capacitor/network": "^5.0.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^0.263.1",
    "qrcode.react": "^4.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "terser": "^5.49.2",
    "three": "^0.185.1",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^5.7.8",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.0.0",
    "@vitest/coverage-v8": "^1.6.1",
    "autoprefixer": "^10.4.0",
    "jsdom": "^24.1.3",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.0.0",
    "vite": "^4.4.0",
    "vitest": "^1.6.1",
    "wabt": "^1.0.39"
  }
}
